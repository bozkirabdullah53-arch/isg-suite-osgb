APP_NAME=İSG Suite OSGB
ENVIRONMENT=development
DATABASE_URL=sqlite:///./isgsuite.db
SECRET_KEY=BURAYA_EN_AZ_32_KARAKTER_GUCLU_ANAHTAR_GIRIN
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_USE_TLS=true
# EİSA Global gelen kutusu (İsimtescil HybridMail / IMAP)
INBOUND_MAIL_ENABLED=false
INBOUND_MAIL_HOST=imap.mailmatik.com
INBOUND_MAIL_PORT=993
INBOUND_MAIL_USERNAME=info@isgsuite.tr
INBOUND_MAIL_PASSWORD=
INBOUND_MAIL_USE_SSL=true
INBOUND_MAIL_FOLDER=INBOX
INBOUND_MAIL_SYNC_LIMIT=50
INBOUND_MAIL_TIMEOUT_SEC=20
BACKUP_DIR=./backups
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Opsiyonel ClamAV (B-01): clamd host — boşsa magic-byte taraması yeterli
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SEC=30
# İBYS / İSG-KATİP adapter scaffold (opsiyonel; gerçek sırları commit etmeyin)
IBYS_API_URL=
IBYS_API_KEY=
KATIP_API_URL=
KATIP_API_KEY=
# Eyas Digital Approval (dijital onay; QES değil). Acil kapatma:
EYAS_DIGITAL_APPROVAL_ENABLED=true
EYAS_DIGITAL_APPROVAL_FORCE_OFF=false
# OSGB e-imza (opsiyonel ağ kontrolleri; varsayılan kapalı)
ESIGN_OCSP_ENABLED=false
ESIGN_CRL_ENABLED=false
ESIGN_TSA_URL=
# Uzaktan Temel İSG modülü — canlıda ayrıca kontrollü açılır
REMOTE_BASIC_OHS_TRAINING_ENABLED=false
REMOTE_BASIC_OHS_TRAINING_FORCE_OFF=false
REMOTE_BASIC_OHS_VIDEO_MAX_UPLOAD_MB=2048
REMOTE_BASIC_OHS_PLAYBACK_TTL_SECONDS=300
# Ortak strict kural motoru — pilot paketleri Yüksekte Çalışma ve Hastaneler; varsayılan kapalı
REMOTE_BASIC_OHS_STRICT_POLICY_ENABLED=false
REMOTE_BASIC_OHS_STRICT_POLICY_FORCE_OFF=false
REMOTE_BASIC_OHS_STRICT_POLICY_PACKAGE_CODES=working-at-height-ohs,health-services-ohs
REMOTE_BASIC_OHS_STRICT_POLICY_PILOT_COMPANY_IDS=
# GPS'li görsel saha denetimi. AI dış çağrısı üç koşul birlikte sağlanmadan açılmaz.
FIELD_INSPECTION_MAX_UPLOAD_MB=15
# 0 otomatik arşivlemeyi kapatır; onaylı raporlar varsayılan olarak korunur.
FIELD_INSPECTION_RETENTION_DAYS=0
FIELD_AI_ENABLED=false
FIELD_AI_FORCE_OFF=false
FIELD_AI_PROVIDER=openai_compatible
FIELD_AI_API_URL=https://api.openai.com/v1/chat/completions
FIELD_AI_API_KEY=
FIELD_AI_MODEL=gpt-4.1-mini
FIELD_AI_MODEL_VERSION=configured
FIELD_AI_PROMPT_VERSION=field-visual-v2
FIELD_AI_TIMEOUT_SECONDS=60
FIELD_AI_DATA_PROCESSING_ALLOWED=false
